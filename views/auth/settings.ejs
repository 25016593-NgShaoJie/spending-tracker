<%- include('partials/header') %>
<%- include('partials/flash') %>

<h1>Settings</h1>

<article>
    <h2>Monthly Budget & Income Baseline</h2>
    <form action="/settings/budget" method="POST">
        <label for="monthly_income">Monthly Income ($)</label>
        <input type="number" step="0.01" id="monthly_income" name="monthly_income" value="<%= settings.monthlyIncome %>" required>

        <label for="target_savings_percentage">Target Savings Percentage (%)</label>
        <input type="number" step="0.1" id="target_savings_percentage" name="target_savings_percentage" value="<%= settings.targetSavingsPercentage %>" required>

        <button type="submit">Save Budget Settings</button>
    </form>
</article>

<article>
    <h2>Google Sheets Integration</h2>
    <% if (settings.googleSheetId) { %>
        <p style="color: #38a169;">Connected Sheet ID: <strong><%= settings.googleSheetId %></strong></p>
    <% } else { %>
        <p>Connect your Google Account to automatically append expenses into a Google Spreadsheet.</p>
    <% } %>

    <form action="/settings/google-sheet" method="POST" style="margin-bottom: 1rem;">
        <label for="google_sheet_id">Google Sheet ID</label>
        <input type="text" id="google_sheet_id" name="google_sheet_id" value="<%= settings.googleSheetId %>" placeholder="e.g. 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms" required>
        <button type="submit" class="secondary">Save Sheet ID</button>
    </form>

    <a href="/auth/google" role="button" class="contrast">Authenticate Google Account</a>
</article>

<%- include('partials/footer') %>