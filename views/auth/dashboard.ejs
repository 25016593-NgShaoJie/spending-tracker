<%- include('partials/header') %>
<%- include('partials/flash') %>

<h1 style="margin-bottom: 1.5rem;">Financial Overview</h1>

<!-- Top Financial Metrics Grid -->
<div class="metrics-grid">
    <div class="card">
        <span style="color: var(--text-muted); font-size: 0.875rem; font-weight: 600;">Spent Today</span>
        <div class="metric-value text-danger">$<%= metrics.spentToday.toFixed(2) %></div>
        <small style="color: var(--text-muted);">Safe Daily Limit: $<%= metrics.safeDailyAllowance.toFixed(2) %></small>
    </div>

    <div class="card">
        <span style="color: var(--text-muted); font-size: 0.875rem; font-weight: 600;">Spent This Month</span>
        <div class="metric-value">$<%= metrics.spentThisMonth.toFixed(2) %></div>
        <small style="color: var(--text-muted);">Monthly Cap: $<%= metrics.totalSpendableAllowance.toFixed(2) %></small>
    </div>

    <div class="card">
        <span style="color: var(--text-muted); font-size: 0.875rem; font-weight: 600;">Remaining Allowance</span>
        <div class="metric-value <%= metrics.remainingMonthlyAllowance < 0 ? 'text-danger' : 'text-success' %>">
            $<%= metrics.remainingMonthlyAllowance.toFixed(2) %>
        </div>
        <small style="color: var(--text-muted);"><%= metrics.daysRemaining %> days left in month</small>
    </div>

    <div class="card">
        <span style="color: var(--text-muted); font-size: 0.875rem; font-weight: 600;">Target Savings</span>
        <div class="metric-value">$<%= metrics.targetSavingsAmount.toFixed(2) %></div>
        <small style="color: var(--text-muted);"><%= metrics.targetSavingsPercentage %>% of $<%= metrics.monthlyIncome.toFixed(2) %></small>
    </div>
</div>

<!-- Main Split Section: Log Form & Recent Transactions -->
<div class="content-split">
    <!-- Log Expense Form -->
    <div class="card">
        <h3 style="margin-bottom: 1rem;">Log Expense</h3>
        <form action="/expenses" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label for="amount">Amount ($)</label>
                <input type="number" step="0.01" id="amount" name="amount" placeholder="0.00" required>
            </div>

            <div class="form-group">
                <label for="category">Category</label>
                <select id="category" name="category" required>
                    <option value="" disabled selected>Select Category</option>
                    <option value="Food & Dining">Food & Dining</option>
                    <option value="Transportation">Transportation</option>
                    <option value="Groceries">Groceries</option>
                    <option value="Utilities">Utilities</option>
                    <option value="Entertainment">Entertainment</option>
                    <option value="Shopping">Shopping</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="form-group">
                <label for="date_spent">Date</label>
                <input type="date" id="date_spent" name="date_spent" value="<%= new Date().toISOString().split('T')[0] %>" required>
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <input type="text" id="description" name="description" placeholder="e.g. Lunch at Chipotle">
            </div>

            <div class="form-group">
                <label for="receiptImage">Receipt / Take Photo</label>
                <input 
                    type="file" 
                    id="receiptImage" 
                    name="receiptImage" 
                    accept="image/*" 
                    capture="environment"
                >
                <small style="color: var(--text-muted); display: block; margin-top: 0.25rem;">
                    Snap a photo with your camera or select an image file.
                </small>
            </div>

            <button type="submit" class="btn btn-primary" style="margin-top: 0.5rem;">Add Expense</button>
        </form>
    </div>

    <!-- Recent Transactions Table -->
    <div class="card">
        <h3 style="margin-bottom: 1rem;">Recent Transactions</h3>
        <% if (recentExpenses && recentExpenses.length > 0) { %>
            <div style="overflow-x: auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Receipt</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentExpenses.forEach(expense => { %>
                            <tr>
                                <td><%= new Date(expense.date_spent).toLocaleDateString() %></td>
                                <td><%= expense.category %></td>
                                <td style="font-weight: 600;">$<%= Number(expense.amount).toFixed(2) %></td>
                                <td>
                                    <% if (expense.has_receipt || expense.image_url) { %>
                                        <a href="<%= expense.image_url || ('/expenses/receipt/' + expense.id) %>" target="_blank" rel="noopener" style="color: var(--primary); font-weight: 500;">View</a>
                                    <% } else { %>
                                        <span style="color: var(--text-muted);">-</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p style="color: var(--text-muted);">No expenses logged yet.</p>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>