<%- include('partials/header') %>
<%- include('partials/flash') %>

<h1>Financial Overview</h1>

<div class="grid">
    <article>
        <header><strong>Spent Today</strong></header>
        <h3 style="color: #e53e3e;">$<%= metrics.spentToday.toFixed(2) %></h3>
        <small>Safe Daily Limit: $<%= metrics.safeDailyAllowance.toFixed(2) %></small>
    </article>
    <article>
        <header><strong>Spent This Month</strong></header>
        <h3>$<%= metrics.spentThisMonth.toFixed(2) %></h3>
        <small>Monthly Cap: $<%= metrics.totalSpendableAllowance.toFixed(2) %></small>
    </article>
    <article>
        <header><strong>Remaining Allowance</strong></header>
        <h3 style="<%= metrics.remainingMonthlyAllowance < 0 ? 'color: #e53e3e;' : 'color: #38a169;' %>">
            $<%= metrics.remainingMonthlyAllowance.toFixed(2) %>
        </h3>
        <small><%= metrics.daysRemaining %> days left in month</small>
    </article>
    <article>
        <header><strong>Target Savings</strong></header>
        <h3>$<%= metrics.targetSavingsAmount.toFixed(2) %></h3>
        <small><%= metrics.targetSavingsPercentage %>% of $<%= metrics.monthlyIncome.toFixed(2) %></small>
    </article>
</div>

<div class="grid">
    <article>
        <h3>Log Expense</h3>
        <form action="/expenses" method="POST" enctype="multipart/form-data">
            <label for="amount">Amount ($)</label>
            <input type="number" step="0.01" id="amount" name="amount" placeholder="0.00" required>

            <label for="category">Category</label>
            <select id="category" name="category" required>
                <option value="" disabled selected>Select Category</option>
                <option value="Food & Dining">Food & Dining</option>
                <option value="Transportation">Transportation</option>
                <option value="Groceries">Groceries</option>
                <option value="Utilities">Utilities</option>
                <option value="Entertainment">Entertainment</option>
                <option value="Shopping">Shopping</option>
                <option value="Other">Other</option>
            </select>

            <label for="date_spent">Date</label>
            <input type="date" id="date_spent" name="date_spent" value="<%= new Date().toISOString().split('T')[0] %>" required>

            <label for="description">Description</label>
            <input type="text" id="description" name="description" placeholder="e.g. Lunch at Chipotle">

            <label for="receiptImage">Receipt / Image</label>
            <input type="file" id="receiptImage" name="receiptImage" accept="image/*">

            <button type="submit">Add Expense</button>
        </form>
    </article>

    <article>
        <h3>Recent Transactions</h3>
        <% if (recentExpenses.length > 0) { %>
            <figure>
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Receipt</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentExpenses.forEach(expense => { %>
                            <tr>
                                <td><%= new Date(expense.date_spent).toLocaleDateString() %></td>
                                <td><%= expense.category %></td>
                                <td>$<%= Number(expense.amount).toFixed(2) %></td>
                                <td>
                                    <% if (expense.image_url) { %>
                                        <a href="<%= expense.image_url %>" target="_blank" rel="noopener">View</a>
                                    <% } else { %>
                                        <span>-</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </figure>
        <% } else { %>
            <p>No expenses logged yet.</p>
        <% } %>
    </article>
</div>

<%- include('partials/footer') %>