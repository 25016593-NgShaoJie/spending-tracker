<%- include('partials/header') %>
<%- include('partials/flash') %>

<h1>Expense History</h1>

<article>
    <form action="/expenses" method="GET" class="grid">
        <div>
            <label for="startDate">Start Date</label>
            <input type="date" id="startDate" name="startDate" value="<%= filters.startDate %>">
        </div>
        <div>
            <label for="endDate">End Date</label>
            <input type="date" id="endDate" name="endDate" value="<%= filters.endDate %>">
        </div>
        <div>
            <label for="category">Category</label>
            <select id="category" name="category">
                <option value="All" <%= filters.category === 'All' ? 'selected' : '' %>>All Categories</option>
                <option value="Food & Dining" <%= filters.category === 'Food & Dining' ? 'selected' : '' %>>Food & Dining</option>
                <option value="Transportation" <%= filters.category === 'Transportation' ? 'selected' : '' %>>Transportation</option>
                <option value="Groceries" <%= filters.category === 'Groceries' ? 'selected' : '' %>>Groceries</option>
                <option value="Utilities" <%= filters.category === 'Utilities' ? 'selected' : '' %>>Utilities</option>
                <option value="Entertainment" <%= filters.category === 'Entertainment' ? 'selected' : '' %>>Entertainment</option>
                <option value="Shopping" <%= filters.category === 'Shopping' ? 'selected' : '' %>>Shopping</option>
                <option value="Other" <%= filters.category === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
        </div>
        <div style="display: flex; align-items: flex-end; gap: 0.5rem;">
            <button type="submit">Filter</button>
            <a href="/expenses" role="button" class="secondary outline">Clear</a>
        </div>
    </form>
</article>

<article>
    <% if (expenses.length > 0) { %>
        <figure>
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Amount</th>
                        <th>Receipt</th>
                    </tr>
                </thead>
                <tbody>
                    <% expenses.forEach(expense => { %>
                        <tr>
                            <td><%= new Date(expense.date_spent).toLocaleDateString() %></td>
                            <td><%= expense.category %></td>
                            <td><%= expense.description || '-' %></td>
                            <td>$<%= Number(expense.amount).toFixed(2) %></td>
                            <td>
                                <% if (expense.image_url) { %>
                                    <a href="<%= expense.image_url %>" target="_blank" rel="noopener">View Receipt</a>
                                <% } else { %>
                                    <span>None</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </figure>
    <% } else { %>
        <p>No expenses found matching criteria.</p>
    <% } %>
</article>

<%- include('partials/footer') %>