<%- include('../partials/header') %>
<div class="auth-wrap">
  <div class="card auth-card auth-card-wide">
    <div class="sidebar-brand">
      <span class="word1 display">CASH<span class="word2 display">WISELY</span></span>
      <span class="brand-sub">smart spending, tracked.</span>
    </div>

    <%- include('../partials/flash') %>

    <h2>Create Account</h2>
    <form action="/register" method="POST" id="registerForm">
        <div class="form-group">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" required placeholder="johndoe">
        </div>
        <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" required placeholder="you@example.com">
        </div>
        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required>
        </div>

        <hr>

        <div class="form-group">
            <label for="monthly_income">Monthly Income / Allowance ($)</label>
            <input type="number" step="0.01" min="0" id="monthly_income" name="monthly_income" required placeholder="e.g. 3000.00">
        </div>

        <div class="form-group">
            <label>Savings Goal</label>
            <div class="segmented-toggle">
                <div class="seg-option">
                    <input type="radio" id="goalPercentage" name="savings_goal_type" value="percentage" checked>
                    <label for="goalPercentage">% per month</label>
                </div>
                <div class="seg-option">
                    <input type="radio" id="goalFixed" name="savings_goal_type" value="fixed_monthly">
                    <label for="goalFixed">$ per month</label>
                </div>
                <div class="seg-option">
                    <input type="radio" id="goalTarget" name="savings_goal_type" value="target_date">
                    <label for="goalTarget">Save by a date</label>
                </div>
            </div>

            <!-- Option A: percentage of income per month -->
            <div class="goal-panel active" data-panel="percentage">
                <div class="form-group">
                    <label for="target_savings_percentage">Percentage of income to save (%)</label>
                    <input type="number" step="0.1" min="0" max="100" id="target_savings_percentage" name="target_savings_percentage" placeholder="e.g. 20" value="20">
                </div>
            </div>

            <!-- Option B: fixed dollar amount per month -->
            <div class="goal-panel" data-panel="fixed_monthly">
                <div class="form-group">
                    <label for="target_savings_amount">Amount to save per month ($)</label>
                    <input type="number" step="0.01" min="0" id="target_savings_amount" name="target_savings_amount" placeholder="e.g. 500.00">
                </div>
            </div>

            <!-- Option C: total amount saved by a target date -->
            <div class="goal-panel" data-panel="target_date">
                <div class="form-group">
                    <label for="savings_goal_amount">Total amount you want to save ($)</label>
                    <input type="number" step="0.01" min="0" id="savings_goal_amount" name="savings_goal_amount" placeholder="e.g. 5000.00">
                </div>
                <div class="form-group">
                    <label for="savings_goal_date">Target date</label>
                    <input type="date" id="savings_goal_date" name="savings_goal_date">
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Create Account</button>
    </form>
    <p>Already have an account? <a href="/login">Log in here</a></p>
  </div>
</div>

<script>
(function () {
    var form = document.getElementById('registerForm');
    var radios = form.querySelectorAll('input[name="savings_goal_type"]');
    var panels = form.querySelectorAll('.goal-panel');

    // Inputs that should only be required when their panel is the active one
    var conditional = {
        percentage: [document.getElementById('target_savings_percentage')],
        fixed_monthly: [document.getElementById('target_savings_amount')],
        target_date: [document.getElementById('savings_goal_amount'), document.getElementById('savings_goal_date')]
    };

    function setActive(goalType) {
        panels.forEach(function (panel) {
            panel.classList.toggle('active', panel.dataset.panel === goalType);
        });
        Object.keys(conditional).forEach(function (key) {
            conditional[key].forEach(function (input) {
                if (!input) return;
                input.required = (key === goalType);
            });
        });
    }

    radios.forEach(function (radio) {
        radio.addEventListener('change', function () {
            if (radio.checked) setActive(radio.value);
        });
    });

    // Initialize on load to match whichever option starts checked
    setActive(form.querySelector('input[name="savings_goal_type"]:checked').value);
})();
</script>

<%- include('../partials/footer') %>
