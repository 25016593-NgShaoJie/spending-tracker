<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<article style="max-width: 500px; margin: 2rem auto;">
    <h2>Create a CashWisely Account</h2>
    <form action="/register" method="POST">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" required placeholder="johndoe">

        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" required placeholder="you@example.com">

        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>

        <button type="submit">Create Account</button>
    </form>
    <p style="text-align: center;">Already have an account? <a href="/login">Log in here</a></p>
</article>

<%- include('../partials/footer') %>